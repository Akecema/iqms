# Copy to .env and fill in for your environment. Never commit the real .env.
# On Azure App Service, set these as Application Settings instead of a .env
# file — App Service exposes Application Settings to PHP as environment
# variables automatically, no .env loader needed.

# --- MySQL connection (db/db_connect.php) ---
# App connects to TWO databases on the same server/credentials.
DB_HOST=172.18.4.11
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME1=ingress_group
DB_NAME2=iqms
