# Azure App Service (Linux, native PHP runtime) uses Apache under the hood
# for this deploy path, and reads .htaccess from the docroot the same way
# .user.ini is read (see .user.ini for why — same App Service deploy-path
# constraint, no Dockerfile/custom startup script).

# Disable directory listing. Without this, requesting a folder with no
# index file (e.g. /pages/vendor/) lists every file in it - harmless on
# its own since every page already requires a login (see
# pages/session-start.php), but it still hands an attacker a free map of
# the app's internal file/folder structure for no benefit to anyone.
Options -Indexes

# Block direct HTTP access to config/secret-adjacent files that happen to
# live inside the docroot. None of these are ever meant to be served as a
# response body - .env would leak real credentials, .user.ini/.htaccess
# reveal server config, and db/ holds the DB connection file. This is an
# HTTP-layer block only - PHP's own include '../db/db_connect.php' calls
# are server-side and unaffected.
<FilesMatch "(^\.env$|^\.env\..*|^\.user\.ini$|^\.htaccess$|^composer\.(json|lock)$)">
    Require all denied
</FilesMatch>

<IfModule mod_alias.c>
    RedirectMatch 403 ^/db/
</IfModule>
